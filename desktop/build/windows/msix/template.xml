<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="atlas-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\overtoneblue\Atlas">
    </Installer>
    <PackageInformation
        PackageName="Atlas"
        PackageDisplayName="Atlas"
        PublisherName="CN=overtoneblue"
        PublisherDisplayName="overtoneblue"
        Version="1.0.0-dev.0"
        PackageDescription="Atlas — workstream client for Hermes">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.cenunix.atlas"
                Description="Atlas — workstream client for Hermes"
                DisplayName="Atlas"
                ExecutableName="atlas-desktop"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Atlas</DisplayName>
            <PublisherDisplayName>overtoneblue</PublisherDisplayName>
            <Description>Atlas — workstream client for Hermes</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="atlas-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
